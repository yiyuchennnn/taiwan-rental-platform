generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ========================================
// 1. 使用者角色
// ========================================

enum UserRole {
  RENTER
  PUBLISHER
  ADMIN
}

enum PaidPlan {
  BASIC
  ADVANCED
  FLAGSHIP
}

enum EntitlementSource {
  PURCHASE
  GIFT
}

enum PublisherType {
  LANDLORD
  AGENT
  AUTHORIZED_REPRESENTATIVE
}

enum ListingStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
  ARCHIVED
  TRASHED
  DELETED
}

// 02-06 已列出的四種計費方式；null 表示尚未填答。
enum BillingMethod {
  INCLUDED
  BY_BILL
  SEPARATE
  NOT_PROVIDED
}

// 封存原因與生命週期分開；舊 UNPUBLISHED 保留相容，不自動猜測原因。
enum ArchiveReason {
  MANUAL
  RENTED
  QUOTA_EXCEEDED
}

enum ModerationStatus {
  NONE
  SUSPENDED
  BLOCKED
}

// ========================================
// 2. 使用者 User
// ========================================

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  name          String?
  passwordHash  String?
  phone         String?
  role          UserRole       @default(RENTER)
  publisherType PublisherType?
  isActive      Boolean        @default(true)

  // 02-11：僅保存驗證結果，不代表已完成驗證流程。
  emailVerifiedAt     DateTime?
  contactVerifiedAt   DateTime?
  publisherVerifiedAt DateTime?

  createdProperties Property[]
  listings          Listing[]
  sessions          AuthSession[]
  entitlementAccount EntitlementAccount?
  entitlementPeriods EntitlementPeriod[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
}

// Missing/unknown account facts never imply a free downgrade of an existing account.
model EntitlementAccount {
  userId     String @id
  user       User @relation(fields: [userId], references: [id], onDelete: Restrict)
  verifiedAt DateTime?
  provenance String
  createdAt  DateTime @default(now())
}

// Internal facts, not a payment or gift issuance API. External confirmation writers remain unimplemented.
model EntitlementPeriod {
  id              String @id @default(uuid())
  userId          String
  user            User @relation(fields: [userId], references: [id], onDelete: Restrict)
  plan            PaidPlan
  source          EntitlementSource
  sourceReference String
  startsAt        DateTime
  endsAt          DateTime
  confirmedAt     DateTime?
  revokedAt       DateTime?
  createdAt       DateTime @default(now())

  @@unique([source, sourceReference])
  @@index([userId, startsAt, endsAt])
}

// Opaque bearer tokens are returned once; only SHA-256 digests are retained.
model AuthSession {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  @@index([userId])
  @@index([expiresAt])
}

// ========================================
// 3. 實體房屋 Property
// ========================================

model Property {
  id String @id @default(uuid())

  // 房屋所在地區
  cityCode      String
  districtCode  String
  communityName String?
  addressLine   String

  // 縣市與行政區組合關聯
  district District @relation(fields: [cityCode, districtCode], references: [cityCode, code])

  // 實際出租單位
  floor      Int?
  roomNumber String?

  // 地圖座標
  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)

  // 建立資料者，不代表法律所有權人
  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  listings Listing[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdById])
  @@index([cityCode, districtCode])
}

// ========================================
// 4. 刊登資料 Listing
// ========================================

model Listing {
  id String @id @default(uuid())
  revision Int @default(1)
  publicationHistory String @default("NEVER")
  publicId String @unique @default(uuid())

  areaSource String?
  elevatorStatus String?
  petPolicy String?
  cookingPolicy String?
  laundryStatus String?
  dryingStatus String?
  garbageStatus String?
  subsidyPolicy String?
  minimumLeaseMonths Int?
  floors Int[] @default([])
  carParkingStatus String?
  motorcycleParkingStatus String?
  carParkingRequired Boolean?
  motorcycleParkingRequired Boolean?
  carParkingFrequency String?
  motorcycleParkingFrequency String?
  contactExtension String?
  authorizationDescription String?
  utilityCharges ListingUtilityCharge[]
  equipmentItems ListingEquipmentItem[]
  feeItems ListingFeeItem[]

  title                           String?
  description                     String?
  // 02-06：未定選項先用 nullable 文字，不發明固定選單或預設值。
  rentalType                      String?
  buildingType                    String?
  buildingDescription             String?
  depositMode                     String?
  depositMonths                   Decimal?       @db.Decimal(12, 4)
  managementFeeMode               String?
  occupancyMode                   String?
  floorMode                       String?
  floorFrom                       Int?
  floorTo                         Int?
  balconyMode                     String?
  sharedSpaces                    String[]       @default([])
  sharedSpaceDescription          String?
  equipmentMode                   String?
  areaPings                       Decimal?       @db.Decimal(12, 4)
  areaType                        String?
  bedrooms                        Int?
  livingRooms                     Int?
  bathrooms                       Int?
  balconies                       Int?
  totalFloors                     Int?
  isWholeBuilding                 Boolean?
  hasElevator                     Boolean?
  managementFee                   Int?
  waterBilling                    BillingMethod?
  waterFeeDescription             String?
  electricityBilling              BillingMethod?
  electricityFeeDescription       String?
  gasBilling                      BillingMethod?
  gasFeeDescription               String?
  internetBilling                 BillingMethod?
  internetFeeDescription          String?
  hasCarParking                   Boolean?
  carParkingType                  String?
  carParkingIncludedInRent        Boolean?
  carParkingFee                   Int?
  hasMotorcycleParking            Boolean?
  motorcycleParkingType           String?
  motorcycleParkingIncludedInRent Boolean?
  motorcycleParkingFee            Int?
  // 未定設備分類不預填清單；equipmentConfirmedAt 為 null 時，空陣列不代表沒有設備。
  furniture                       String[]       @default([])
  appliances                      String[]       @default([])
  equipmentConfirmedAt            DateTime?
  cookingAllowed                  Boolean?
  laundryDescription              String?
  dryingDescription               String?
  garbageDisposalDescription      String?
  minimumLeaseTerm                String?
  availableFrom                   DateTime?      @db.Date
  petsAllowed                     Boolean?
  petConditions                   String?
  petFeeDescription               String?
  additionalConditions            String?
  subsidyDescription              String?
  rent                            Int?
  deposit                         Int?

  status           ListingStatus    @default(DRAFT)
  moderationStatus ModerationStatus @default(NONE)
  archiveReason    ArchiveReason?
  trashedAt        DateTime?

  // C08：全方案可明確選擇公開；仍須檢查當前同意、內容資格與隱私，並非付費權益。
  exactAddressConsentAt DateTime?

  // 02-06：房源聯絡資料獨立於帳號及未來品牌。
  contactName           String?
  contactPhone          String?
  contactEmail          String?
  contactLine           String?
  publisherType         PublisherType?
  companyName           String?
  serviceFeeDescription String?

  // 02-06：未填地址的草稿不建立假的實體房屋。
  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: Restrict)

  publisherId String
  publisher   User   @relation(fields: [publisherId], references: [id])

  media ListingMedia[]
  draftAddress DraftAddress?

  // 舊 publishedAt 的歷史語意未確認，保留且不自動回填。
  firstPublishedAt DateTime?
  publishedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([propertyId])
  @@index([publisherId])
  @@index([status, moderationStatus])
  @@index([rent])
}

// ========================================
// 5. 刊登媒體 ListingMedia
// ========================================

model ListingMedia {
  id String @id @default(uuid())

  // 舊圖片 URL 保留；新圖片可引用共用資產，刪除刊登不連帶刪資產。
  assetId String?
  asset   MediaAsset? @relation(fields: [assetId], references: [id], onDelete: Restrict)

  url       String
  sortOrder Int     @default(0)
  isCover   Boolean @default(false)

  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([listingId])
  @@index([listingId, sortOrder])
  @@index([assetId])
}

// ========================================
// 6. 縣市 City
// ========================================

model City {
  publicationPolicy String @default("NOT_OPEN")
  code      String  @id
  name      String  @unique
  isEnabled Boolean @default(false)

  districts District[]
  draftAddresses DraftAddress[]
}

// ========================================
// 7. 行政區 District
// ========================================

model District {
  code     String
  name     String
  cityCode String

  city       City       @relation(fields: [cityCode], references: [code])
  properties Property[]
  draftAddresses DraftAddress[]

  @@id([cityCode, code])
  @@unique([cityCode, name])
  @@index([cityCode])
}

// Private per-listing working copy. Never directly changes shared Property or a public address.
model DraftAddress {
  listingId     String @id
  listing       Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  cityCode      String?
  districtCode  String?
  addressLine   String?
  roomNumber    String?
  communityName String?
  buildingNumber String?
  roomIdentifierSource String?
  addressKind String?
  city          City? @relation(fields: [cityCode], references: [code], onDelete: Restrict)
  district      District? @relation(fields: [cityCode, districtCode], references: [cityCode, code], onDelete: Restrict)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// 02-09：僅保存處理後展示圖／縮圖，不存長期原圖；不預設任何方案 GB。
// 位元組為實際儲存大小；null 表示尚未量測，不能當成零容量。
model MediaAsset {
  id             String         @id @default(uuid())
  displayUrl     String
  thumbnailUrl   String
  displayBytes   BigInt?
  thumbnailBytes BigInt?
  gpsRemovedAt   DateTime?
  createdAt      DateTime       @default(now())
  listingMedia   ListingMedia[]
}

// Durable storage ownership and recovery record. Snapshot IDs intentionally survive
// listing/user removal so an orphaned private object can still be reconciled.
model MediaUpload {
  id String @id
  ownerId String
  requestKey String
  inputDigest String
  listingId String
  nonce String
  namespace String
  state String
  reservedBytes BigInt
  leaseUntil DateTime
  rightsConfirmedAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([listingId, state])
  @@unique([ownerId, requestKey])
  @@index([state, leaseUntil])
}

// New R02 data is explicit. Legacy free-text/scalar fields are retained, never guessed.
model ListingUtilityCharge {
  listingId String
  kind String
  listing Listing @relation(fields:[listingId], references:[id], onDelete:Cascade)
  mode String
  amount Int?
  rate Decimal? @db.Decimal(12,2)
  unit String?
  frequency String?
  source String?
  description String?
  variableRate Boolean @default(false)
  @@id([listingId,kind])
}
model ListingEquipmentItem {
  listingId String
  code String
  listing Listing @relation(fields:[listingId], references:[id], onDelete:Cascade)
  status String
  @@id([listingId,code])
}
model ListingFeeItem {
  percentage Decimal? @db.Decimal(5,2)
  paymentTiming String?
  payee String?
  id String @id @default(uuid())
  listingId String
  listing Listing @relation(fields:[listingId], references:[id], onDelete:Cascade)
  kind String
  label String
  mode String
  amount Int?
  frequency String?
  required Boolean
  description String?
  @@index([listingId])
}

// Durable safe receipts: no content, addresses or contact snapshots in replay results.
model ContentOperation {
  id String @id @default(uuid())
  ownerId String
  type String
  requestKey String
  requestDigest String
  listingId String
  revision Int
  resultStatus String
  createdAt DateTime @default(now())
  @@unique([ownerId,type,requestKey])
  @@index([listingId])
}
model ListingPreview {
  id String @id @default(uuid())
  contextDigest String
  ownerId String
  listingId String
  revision Int
  createdAt DateTime @default(now())
  @@index([listingId])
}
// Whitelisted public projection, never a serialized Listing ORM object.
model ListingPublication {
  listingId String @id
  publicId String @unique
  revision Int
  snapshot Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model ContentEvent {
  id String @id @default(uuid())
  operationId String
  listingId String
  type String
  revision Int
  createdAt DateTime @default(now())
  @@unique([operationId,type])
  @@index([listingId,revision])
}
